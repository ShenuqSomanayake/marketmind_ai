# Copy to your host's secrets manager. Never commit real values.
ANTHROPIC_API_KEY=            # optional: enables LLM research briefs
MARKETMIND_AI_MODEL=claude-sonnet-5-5
MARKETMIND_DB_PATH=           # optional: defaults to ./marketmind.db
MARKETMIND_FACTUAL_MODE=0     # 1 for any deployment other people use: neutral labels, descriptive AI only
MARKETMIND_AI_DAILY_LIMIT=0   # max AI generations per user per day; 0 = unlimited (personal use)
