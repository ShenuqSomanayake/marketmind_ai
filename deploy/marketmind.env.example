# /etc/marketmind.env — read by systemd (root-only, chmod 600). Never commit real values.
# Leave ANTHROPIC_API_KEY empty to use rules-based briefs only.
ANTHROPIC_API_KEY=
MARKETMIND_AI_MODEL=claude-haiku-5-5
MARKETMIND_AI_DAILY_LIMIT=20
MARKETMIND_DB_PATH=/var/lib/marketmind/marketmind.db
# 1 for any deployment other people use (beta testers):
MARKETMIND_FACTUAL_MODE=0
